# Copy this file to .env and fill in real values.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Windows (cmd):         copy .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env is git-ignored. Never commit it, and never put a real key in this file.
# Every value below is a placeholder.


# --- Model access ----------------------------------------------------------
# The provider decision is deliberately open until API access is confirmed.
# See docs/decisions.md, D-014. Nothing in the current build reads these
# values, because no model call is implemented yet.

# Which provider adapter to use once implemented. Leave blank for now.
MODEL_PROVIDER=

# The model identifier for that provider.
MODEL_NAME=

# The provider API key. PLACEHOLDER ONLY — replace with your own key, and keep
# it out of Git.
MODEL_API_KEY=your-api-key-here


# --- Offline sample-data mode ----------------------------------------------
# When true, the application replays recorded fixture responses instead of
# calling a provider, so it can be reviewed without credentials. Fixture output
# is labelled as sample data in the interface.
#
# This mode is entered deliberately, by setting this flag. A failed live model
# call is NEVER silently replaced by a fixture response.

OFFLINE_FIXTURE_MODE=false


# --- Local server ----------------------------------------------------------
# Defaults match the frontend dev proxy in frontend/vite.config.ts. Change both
# if you change either.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
