# Copy this file to .env and fill in your own values.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env is git-ignored. Never commit it, and never put a real key in this file.
# Every value below is a placeholder.


# --- Model access ----------------------------------------------------------
# The provider is OpenAI. The backend starts without these, and the interface
# says so, but no advisory step can run until MODEL_API_KEY is set.

MODEL_PROVIDER=openai

# The model. gpt-5-mini is the default and is what the project was built
# against. It supports the Responses API and Structured Outputs, which this
# application depends on. Change it deliberately if you want a different one;
# the application never switches models on its own.
MODEL_NAME=gpt-5-mini

# Your OpenAI API key. PLACEHOLDER ONLY.
#
# Create one at https://platform.openai.com/api-keys, then paste it here in your
# local .env file. Do not put it in this file, do not paste it into a chat, and
# do not commit it. If a key is ever exposed, revoke it at that same page.
#
# As an alternative to .env, you can set it in your shell before starting:
#   PowerShell:  $env:MODEL_API_KEY = "sk-..."
#   bash/zsh:    export MODEL_API_KEY="sk-..."
MODEL_API_KEY=your-openai-api-key-here


# --- Request shaping -------------------------------------------------------
# Optional. The defaults are set in backend/app/config.py and are fine for the
# sample scenario. Uncomment to override.

# Ceiling on generated tokens per request.
# MAX_OUTPUT_TOKENS=8000

# Per-request timeout in seconds, passed to the SDK.
# MODEL_TIMEOUT_SECONDS=120

# Wall-clock ceiling for one advisory turn, in seconds.
#
# 300 by default. Measured steps run 20 to 60 seconds each, and a turn that
# compares and then recommends needs room for both. This is headroom, not a
# speed setting: lowering it does not make anything faster, it only cuts turns
# off earlier. See docs/decisions.md, D-031.
# MAX_TURN_SECONDS=300

# Reasoning effort for models that support it. Valid values per the reasoning
# guide are none, minimal, low, medium, high, xhigh and max, and support varies
# by model. Leave empty to omit the parameter entirely, which is the safe
# setting if a model rejects it.
# MODEL_REASONING_EFFORT=low


# --- Offline sample-data mode ----------------------------------------------
# Still deferred. The flag is read but nothing implements replay yet, so leave
# it false. When it is built, fixture output will be labelled as sample data in
# the interface, and a failed live call will NEVER be silently replaced by one.

OFFLINE_FIXTURE_MODE=false


# --- Local server ----------------------------------------------------------
# The local addresses are FIXED for this MVP and are not configurable. The
# backend always listens on 127.0.0.1:8000, set in scripts/dev-backend.mjs, and
# the dev server always serves port 5173 with a proxy to that address, set in
# frontend/vite.config.ts. To change either, edit both files. See
# docs/decisions.md, D-015.

# Origins permitted to call the API directly. Unused in normal development,
# because the dev server proxies /api and no browser request is cross-origin.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
